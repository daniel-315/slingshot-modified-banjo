MODULE main

  VAR

		PPARG: {-1, 0, 1};
		NFATC2: {-1, 0, 1};
		BCL6: {-1, 0, 1};
		MAFB: {-1, 0, 1};
		PRDM1: {-1, 0, 1};
		SNAI3: {-1, 0, 1};
		EGR2: {-1, 0, 1};
		ETS1: {-1, 0, 1};
		STAT1: {-1, 0, 1};
		FOS: {-1, 0, 1};
		NFYC: {-1, 0, 1};
		IRF8: {-1, 0, 1};
		TCF3: {-1, 0, 1};
		PPARD: {-1, 0, 1};
		SNAI1: {-1, 0, 1};


    ASSIGN

		init(PPARG) := {-1, 0};
		init(NFATC2) := {-1, 0};
		init(BCL6) := {-1, 0};
		init(MAFB) := {-1, 0};
		init(PRDM1) := {-1, 0};
		init(SNAI3) := {-1, 0};
		init(EGR2) := {-1, 0};
		init(ETS1) := {-1, 0};
		init(STAT1) := {-1, 0};
		init(FOS) := {-1, 0};
		init(NFYC) := {-1, 0};
		init(IRF8) := {-1, 0};
		init(TCF3) := {-1, 0};
		init(PPARD) := {-1, 0};
		init(SNAI1) := {-1, 0};

	 next(PPARG) := 
		 case 
 			  66*ETS1 > 0  : 1; 
 			  66*ETS1 = 0  : 0; 
 			  66*ETS1 < 0  : -1; 
 			 
 		 esac; 

	 next(NFATC2) := NFATC2;

	 next(BCL6) := 
		 case 
 			  2185*PPARD > 0  : 1; 
 			  2185*PPARD = 0  : 0; 
 			  2185*PPARD < 0  : -1; 
 			 
 		 esac; 

	 next(MAFB) := 
		 case 
 			  1014*ETS1 > 0  : 1; 
 			  1014*ETS1 = 0  : 0; 
 			  1014*ETS1 < 0  : -1; 
 			 
 		 esac; 

	 next(PRDM1) := PRDM1;

	 next(SNAI3) := 
		 case 
 			  2315*IRF8 > 0  : 1; 
 			  2315*IRF8 = 0  : 0; 
 			  2315*IRF8 < 0  : -1; 
 			 
 		 esac; 

	 next(EGR2) := 
		 case 
 			  70*STAT1 > 0  : 1; 
 			  70*STAT1 = 0  : 0; 
 			  70*STAT1 < 0  : -1; 
 			 
 		 esac; 

	 next(ETS1) := 
		 case 
 			  59*IRF8 > 0  : 1; 
 			  59*IRF8 = 0  : 0; 
 			  59*IRF8 < 0  : -1; 
 			 
 		 esac; 

	 next(STAT1) := 
		 case 
 			  -2147*ETS1 > 0  : 1; 
 			  -2147*ETS1 = 0  : 0; 
 			  -2147*ETS1 < 0  : -1; 
 			 
 		 esac; 

	 next(FOS) := FOS;

	 next(NFYC) := 
		 case 
 			  1889*ETS1 > 0  : 1; 
 			  1889*ETS1 = 0  : 0; 
 			  1889*ETS1 < 0  : -1; 
 			 
 		 esac; 

	 next(IRF8) := 
		 case 
 			  -2991*ETS1 > 0  : 1; 
 			  -2991*ETS1 = 0  : 0; 
 			  -2991*ETS1 < 0  : -1; 
 			 
 		 esac; 

	 next(TCF3) := TCF3;

	 next(PPARD) := 
		 case 
 			  -839*IRF8 > 0  : 1; 
 			  -839*IRF8 = 0  : 0; 
 			  -839*IRF8 < 0  : -1; 
 			 
 		 esac; 

	 next(SNAI1) := 
		 case 
 			  1969*BCL6 +  -1958*PPARG > 0  : 1; 
 			  1969*BCL6 +  -1958*PPARG = 0  : 0; 
 			  1969*BCL6 +  -1958*PPARG < 0  : -1; 
 			 
 		 esac; 


